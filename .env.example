# Copy this file to .env for local Docker Compose development.
# Replace every placeholder locally; never commit the resulting .env file.
POSTGRES_DB=jobxhunterdb
POSTGRES_USER=jobxhunter
POSTGRES_PASSWORD=change-me-locally
DB_PORT=5432
APP_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/jobxhunterdb
SPRING_DATASOURCE_USERNAME=jobxhunter
SPRING_DATASOURCE_PASSWORD=change-me-locally
SPRING_PROFILES_ACTIVE=local
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-locally
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/jobxhunter
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/jobxhunter/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=jobxhunter-api
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
