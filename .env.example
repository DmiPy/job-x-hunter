# Copy this file to .env for local Docker Compose development.
# Replace every placeholder locally; never commit the resulting .env file.
POSTGRES_DB=jobxhunterdb
POSTGRES_USER=jobxhunter
POSTGRES_PASSWORD=change-me-locally
DB_PORT=5432
APP_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/jobxhunterdb
SPRING_DATASOURCE_USERNAME=jobxhunter
SPRING_DATASOURCE_PASSWORD=change-me-locally
SPRING_PROFILES_ACTIVE=local
